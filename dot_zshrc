# Add deno completions to search path
if [[ ":$FPATH:" != *":/home/lea/.zsh/completions:"* ]]; then export FPATH="/home/lea/.zsh/completions:$FPATH"; fi
# If you come from bash you might have to change your $PATH.
# export PATH=$HOME/bin:/usr/local/bin:$PATH

export ZSH="$HOME/.oh-my-zsh"

ZSH_THEME="arrow"

# You may need to manually set your language environment
# export LANG=en_US.UTF-8
source_if_exists() {
    if test -r "$1"; then
        source "$1"
    fi
}

export EDITOR='nvim'
export TERM=screen-256color
export XDG_CONFIG_HOME=$HOME/.config
export SSH_AUTH_SOCK=$HOME/.bitwarden-ssh-agent.sock
export GITUSER="gpproton"

# Other environment variables
export WORKSPACE=$HOME/spaces
export COMPANY_SPACE=$WORKSPACE/drolx
export CUSTOMER_SPACE=$WORKSPACE/customers
export DOTFILES=$HOME/dots
export VAULT="$WORKSPACE/note-taking"
export SCRIPTS="$WORKSPACE/scripts"

plugins=(
    git
    gh
    ssh
    ansible
    bun
    brew
    chezmoi
    tmux
    archlinux
    aliases
    alias-finder
    colorize
    command-not-found
    common-aliases
    docker
    docker-compose
    macos
    node
    nvm
    python
    rsync
    spring
    zsh-interactive-cd
    zsh-autosuggestions
    zsh-syntax-highlighting
    zsh-autocomplete
)

source_if_exists "$ZSH"/oh-my-zsh.sh

# Set-up icons for files/folders in terminal
alias ls='eza -a --icons'
alias ll='eza -al --icons'
alias lt='eza -a --tree --level=1 --icons'

# Set-up FZF key bindings (CTRL R for fuzzy history finder)
source <(fzf --zsh)

HISTFILE=~/.zsh_history
HISTSIZE=100000
SAVEHIST=100000
setopt appendhistory

source_if_exists $HOME/.sharedrc
source_if_exists $HOME/.zprofile

# bun completions
[ -s "$HOME/.bun/_bun" ] && source "$HOME/.bun/_bun"
. "$HOME/.deno/env"
# Initialize zsh completions (added by deno install script)
autoload -Uz compinit
compinit

#THIS MUST BE AT THE END OF THE FILE FOR SDKMAN TO WORK!!!
export SDKMAN_DIR="/home/lea/.sdkman"
[[ -s "/home/lea/.sdkman/bin/sdkman-init.sh" ]] && source "/home/lea/.sdkman/bin/sdkman-init.sh"
